# ============================================================
# Playwright SDET Framework — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# ----- Application URLs -----
BASE_URL=https://your-app-url.example.com
API_BASE_URL=https://api.your-app-url.example.com

# ----- Test Credentials -----
# Use service accounts — never use real user accounts in tests
TEST_USERNAME=your-test-username@example.com
TEST_PASSWORD=your-secure-test-password

# ----- Environment -----
# Options: local | dev | staging | prod
TEST_ENV=local

# ----- CI Flag -----
# Automatically set to "true" in GitHub Actions; do not change locally
CI=false

# ----- Parallelism -----
WORKERS=4
